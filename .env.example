# Supabase Configuration (Free Tier: 500MB DB, 50k MAU)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-client

# AI Provider Abstraction (Default: free-fallback / ollama for $0 cost)
AI_PROVIDER=free-fallback # Options: ollama | openai-compatible | groq | free-fallback
AI_API_KEY=your-ai-api-key-here
AI_BASE_URL=http://localhost:11434 # Ollama local endpoint or custom proxy
AI_MODEL=llama3:8b

# App & Environment URLs
VITE_APP_URL=http://localhost:5173

# Quotas & Entitlements
MAX_FREE_MATCHES_PER_DAY=10
MAX_FREE_AI_GENERATIONS_PER_MONTH=5
MAX_PRO_AI_GENERATIONS_PER_MONTH=500
